// calculating two integer and printing sum, difference and product
#include<stdio.h>
int main() {
      int a, b;
      scanf("%d%d", &a, &b);
      int sum = a + b;
      int difference = a - b;
      int product = a * b;
      printf("The sum is %d\n", sum);
      printf("The diffrence is %d\n", difference);
      printf("The product is %d\n", product);
      return 0;
}
